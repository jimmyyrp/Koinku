# Salin file ini menjadi .env.local. Jangan commit .env.local.

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL connection string Supabase (server-side only).
# Encode reserved password characters as URL percent-encoding (e.g. & becomes %26).
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.your-project.supabase.co:5432/postgres?sslmode=require
# Optional: relative path to the Supabase root CA certificate downloaded from Dashboard.
DATABASE_SSL_ROOT_CERT_PATH=supabase/certs/prod-ca-2021.crt
