# =================================================
# KOIN KU - Environment Configuration
# Salin file ini menjadi .env.local lalu isi nilainya
# =================================================

# (A) Koneksi SRV Standar (MongoDB Atlas)
# MONGODB_URI=mongodb+srv://koinku_db_user:PASSWORD@cluster0.s9f60uj.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# (B) Koneksi Langsung (tanpa SRV) - bila resolver DNS memblokir query SRV
# MONGODB_URI=mongodb://koinku_db_user:PASSWORD@ac-qrnbvxo-shard-00-00.s9f60uj.mongodb.net:27017,ac-qrnbvxo-shard-00-01.s9f60uj.mongodb.net:27017,ac-qrnbvxo-shard-00-02.s9f60uj.mongodb.net:27017/?ssl=true&retryWrites=true&w=majority&authSource=admin&replicaSet=atlas-a3908i-shard-0&appName=Cluster0

MONGODB_URI=mongodb+srv://koinku_db_user:PASSWORD@cluster0.s9f60uj.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# Nama database MongoDB
MONGODB_DB=koinku