# Salin file ini menjadi .env.local. Jangan commit .env.local.

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# PostgreSQL connection string Supabase (server-side only).
# Gunakan Supabase Connection Pooler (host db.<ref>.supabase.co kini hanya IPv6).
# Format: postgresql://postgres.<project-ref>:PASSWORD@aws-0-<region>.pooler.supabase.com:5432/postgres
# Encode reserved password characters as URL percent-encoding (e.g. & becomes %26).
DATABASE_URL=postgresql://postgres.your-project:YOUR_DATABASE_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Root CA Supabase. Pilih SALAH SATU:
# - Lokal: path ke berkas sertifikat yang diunduh dari Dashboard.
DATABASE_SSL_ROOT_CERT_PATH=supabase/certs/prod-ca-2021.crt
# - Serverless (Vercel): isi PEM sertifikat langsung, atau versi base64-nya.
# DATABASE_SSL_ROOT_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----\n"

# Opsional: batasi ukuran pool koneksi (penting di serverless, mis. 3).
# DATABASE_POOL_MAX=10
